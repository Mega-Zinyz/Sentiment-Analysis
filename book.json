{
  "root": ".",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "title": "Indonesian Sentiment Analysis System",
  "description": "Comprehensive documentation for production-ready Indonesian Sentiment Analysis application with Docker deployment",
  "author": "Mega-Zinyz",
  "language": "en",
  "gitbook": ">=3.0.0",
  "plugins": [
    "anchors",
    "search",
    "expandable-chapters",
    "copy-code-button",
    "github",
    "edit-link",
    "back-to-top-button",
    "-sharing",
    "-fontsettings"
  ],
  "pluginsConfig": {
    "github": {
      "url": "https://github.com/Mega-Zinyz/Sentiment-Analysis"
    },
    "edit-link": {
      "base": "https://github.com/Mega-Zinyz/Sentiment-Analysis/edit/main",
      "label": "Edit on GitHub"
    },
    "theme-default": {
      "showLevel": true,
      "styles": {
        "website": "styles/website.css"
      }
    }
  },
  "links": {
    "sidebar": {
      "Home": "https://github.com/Mega-Zinyz/Sentiment-Analysis",
      "Documentation": "https://mega-zinyz.github.io/Sentiment-Analysis",
      "Issues": "https://github.com/Mega-Zinyz/Sentiment-Analysis/issues"
    }
  },
  "variables": {
    "version": "1.0.0",
    "lastUpdated": "November 12, 2025"
  }
}
