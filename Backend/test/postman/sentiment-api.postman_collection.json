{
  "info": {
    "name": "Sentiment Analysis API",
    "description": "Black-box API test suite for the auth flow of the Sentiment Analysis backend. Run with Newman: `npm run test:api` (requires the backend + MySQL to be up and reachable at {{base_url}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('run_id')) {",
          "  pm.collectionVariables.set('run_id', Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "run_id", "value": "" },
    { "key": "test_username", "value": "" },
    { "key": "test_email", "value": "" },
    { "key": "test_password", "value": "TestPass123" },
    { "key": "auth_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds with 200 or 503', function () {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('response has status and services fields', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('status');",
              "  pm.expect(body).to.have.property('services');",
              "  pm.expect(body.services).to.have.property('database');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - new user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"qa_user_{{run_id}}\",\n  \"email\": \"qa_user_{{run_id}}@example.com\",\n  \"password\": \"{{test_password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('test_username', 'qa_user_' + pm.collectionVariables.get('run_id'));",
              "pm.collectionVariables.set('test_email', 'qa_user_' + pm.collectionVariables.get('run_id') + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registers with 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('response contains new userId', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.be.true;",
              "  pm.expect(body.userId).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - duplicate username is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"email\": \"another_{{run_id}}@example.com\",\n  \"password\": \"{{test_password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects duplicate username with 409', function () {",
              "  pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - wrong password is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"wrong-password\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects wrong password with 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - valid credentials",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logs in with 200 and returns a JWT', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.token).to.be.a('string');",
              "  pm.collectionVariables.set('auth_token', body.token);",
              "});",
              "",
              "pm.test('returned user matches the registered account', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.user.username).to.eql(pm.collectionVariables.get('test_username'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - without token is rejected",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/auth/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects unauthenticated request with 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - with valid token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
        "url": "{{base_url}}/api/auth/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 with the authenticated user', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.user.username).to.eql(pm.collectionVariables.get('test_username'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
        "url": "{{base_url}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logs out with 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Profile - token invalid after logout",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
        "url": "{{base_url}}/api/auth/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('revoked session is rejected with 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
