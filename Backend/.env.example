# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-secure-password
DB_NAME=sentiment_analysis

# JWT Configuration
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Configuration (32 bytes in hex = 64 characters)
# IMPORTANT: Generate a new key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
# Comma-separated list of allowed origins with pattern support
# Examples:
#   Specific domains: https://yourdomain.com,https://www.yourdomain.com
#   Wildcard subdomain: *.yourdomain.com (allows app.yourdomain.com, api.yourdomain.com, etc.)
#   Multiple patterns: https://yourdomain.com,*.staging.yourdomain.com
# SECURITY WARNING: Avoid wildcards like * or https://* in production
ALLOWED_ORIGINS=https://yourdomain.com

# Logging Configuration
# Options: error, warn, info, debug
LOG_LEVEL=info

# API Configuration
# Add any third-party API credentials here if needed

# Development Configuration
