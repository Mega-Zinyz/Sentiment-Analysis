        <!-- 2: History Page → Backend: GET Riwayat -->
        <mxCell id="m2" value="GET /api/analysis-history?page=1&amp;limit=20" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;labelBackgroundColor=none;" edge="1" parent="1">
