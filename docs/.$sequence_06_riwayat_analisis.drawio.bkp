        <!-- MESSAGES - Phase 1: Daftar riwayat -->

        <!-- 1: User → History Page: Buka Riwayat Analisis -->
        <mxCell id="m1" value="Buka Riwayat Analisis" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;labelBackgroundColor=none;" edge="1" parent="1">
