            <mxPoint x="470" y="228" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4: Database self: Query -->
        <mxCell id="m4" value="ORDER BY created_at DESC" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;rounded=0;curved=0;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" x="-0.2593" y="5" as="geometry">
