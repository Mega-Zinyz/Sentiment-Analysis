# Docker Compose Environment Configuration Template
# Copy this file to .env and update with your values

# Environment Mode
# Options: development, production
NODE_ENV=production

# Database Configuration
DB_ROOT_PASSWORD=your-strong-root-password
DB_NAME=sentiment_analysis
DB_USER=sentiment_user
DB_PASSWORD=your-strong-database-password

# Backend Configuration
PORT=5000

# Security - CRITICAL: Generate new secrets for production!
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-change-this

# Generate ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-encryption-key-change-this

# CORS Configuration
# Comma-separated list of allowed origins for production
# Examples:
#   Specific: https://yourdomain.com,https://www.yourdomain.com
#   Wildcard subdomain: *.yourdomain.com (allows any subdomain)
#   Multiple wildcards: *.yourdomain.com,*.anotherdomain.com
# SECURITY: Use specific domains when possible. Wildcards should be limited to your own domains only.
ALLOWED_ORIGINS=https://yourdomain.com

# Logging
# Options: error, warn, info, debug
LOG_LEVEL=info
